# =============================================================================
# CONFIGURAÇÕES GERAIS / COMPARTILHADAS
# =============================================================================

# Timezone
TZ=America/Sao_Paulo

# PostgreSQL (usado por todos os serviços)
POSTGRES_USER=seu_usuario_postgres
POSTGRES_PASSWORD=sua_senha_postgres_segura

# Redis (usado por n8n, Chatwoot e Evolution API)
REDIS_PASSWORD=sua_senha_redis_segura
REDIS_DB=0

# =============================================================================
# N8N - Automação de Workflows (auto1.azapfy.com.br)
# =============================================================================

# Rede / URLs
N8N_HOST=auto1.azapfy.com.br
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://auto1.azapfy.com.br
N8N_SECURE_COOKIE=true

# Segurança
N8N_ENCRYPTION_KEY=sua_chave_de_criptografia_n8n_muito_segura
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=sua_senha_admin_n8n
N8N_DIAGNOSTICS_ENABLED=false

# Banco de Dados
POSTGRES_DB_N8N=n8n_db
DB_POSTGRESDB_SCHEMA=public

# =============================================================================
# CHATWOOT - Plataforma de Atendimento (auto2.azapfy.com.br)
# =============================================================================

# Banco de Dados
CHATWOOT_DB_NAME=chatwoot_db

# AWS S3 para armazenamento de arquivos
CHATWOOT_AWS_ACCESS_KEY_ID=sua_access_key_aws
CHATWOOT_AWS_SECRET_ACCESS_KEY=sua_secret_key_aws

# Segurança
CHATWOOT_SECRET_KEY_BASE=sua_chave_secreta_base_chatwoot_muito_longa_e_segura

# Email SMTP (Gmail)
CHATWOOT_SMTP_PASSWORD=sua_senha_app_gmail

# =============================================================================
# EVOLUTION API - WhatsApp API (auto3.azapfy.com.br)
# =============================================================================

# RabbitMQ (opcional, atualmente desabilitado)
RABBITMQ_URI=amqp://user:password@rabbitmq:5672

# AWS S3 para armazenamento
EVOLUTION_S3_ACCESS_KEY=sua_access_key_aws_evolution
EVOLUTION_S3_SECRET_KEY=sua_secret_key_aws_evolution

# Autenticação
EVOLUTION_AUTHENTICATION_API_KEY=sua_chave_api_evolution_muito_segura

# =============================================================================
# MCP SERVER - Servidor de Ferramentas Customizado
# =============================================================================

# Banco de Dados
POSTGRES_DB=mcp_db
