# =============================================================================
# Configuração do Ambiente - Sistema de Atendimento
# =============================================================================
# Copie este arquivo para .env e preencha os valores
# Comando: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# GERAL
# -----------------------------------------------------------------------------
TZ=America/Sao_Paulo

# -----------------------------------------------------------------------------
# POSTGRESQL
# -----------------------------------------------------------------------------
POSTGRES_DB=postgres
POSTGRES_USER=admin
POSTGRES_PASSWORD=SUA_SENHA_SEGURA_AQUI
# Versão URL-encoded da senha (troque @ por %40, # por %23, etc.)
POSTGRES_PASSWORD_ENCODED=SUA_SENHA_SEGURA_AQUI_ENCODED

# Databases (criados automaticamente pelo init.sql)
POSTGRES_DB_N8N=n8n_db
CHATWOOT_DB_NAME=chatwoot_db
EVOLUTION_DB_NAME=evolution_db

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
REDIS_PASSWORD=SUA_SENHA_REDIS_AQUI
# Versão URL-encoded da senha (troque @ por %40, # por %23, etc.)
REDIS_PASSWORD_ENCODED=SUA_SENHA_REDIS_AQUI_ENCODED
REDIS_DB=0

# -----------------------------------------------------------------------------
# TRAEFIK - Reverse Proxy
# Dashboard: https://traefik.seudominio.com.br
# -----------------------------------------------------------------------------
TRAEFIK_HOST=traefik.seudominio.com.br
ACME_EMAIL=admin@seudominio.com.br

# -----------------------------------------------------------------------------
# N8N - Workflow Automation
# URL: https://n8n.seudominio.com.br
# -----------------------------------------------------------------------------
N8N_HOST=n8n.seudominio.com.br
N8N_ENCRYPTION_KEY=CHAVE_DE_32_CARACTERES_ALEATORIOS

# -----------------------------------------------------------------------------
# CHATWOOT - Customer Support
# URL: https://chatwoot.seudominio.com.br
# -----------------------------------------------------------------------------
CHATWOOT_HOST=chatwoot.seudominio.com.br
CHATWOOT_SECRET_KEY_BASE=CHAVE_SECRETA_LONGA_AQUI

# SMTP (Email)
SMTP_SENDER_EMAIL=noreply@seudominio.com.br
SMTP_DOMAIN=gmail.com
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=seu_email@gmail.com
CHATWOOT_SMTP_PASSWORD=SUA_SENHA_DE_APP_GMAIL

# -----------------------------------------------------------------------------
# EVOLUTION API - WhatsApp Integration
# URL: https://evolution.seudominio.com.br
# -----------------------------------------------------------------------------
EVOLUTION_HOST=evolution.seudominio.com.br
EVOLUTION_AUTHENTICATION_API_KEY=SUA_API_KEY_EVOLUTION_AQUI

# -----------------------------------------------------------------------------
# MINIO - Object Storage (S3 Compatible)
# API: https://minio.seudominio.com.br
# Console: https://minio-console.seudominio.com.br
# Monitoramento (Portainer): https://minio.seudominio.com.br/monitoramento
# -----------------------------------------------------------------------------
MINIO_HOST=minio.seudominio.com.br
MINIO_CONSOLE_HOST=minio-console.seudominio.com.br
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=SUA_SENHA_MINIO_AQUI
CHATWOOT_BUCKET_NAME=chatwoot
EVOLUTION_BUCKET_NAME=evolution
